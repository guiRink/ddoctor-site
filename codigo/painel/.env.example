# Copie para .env.local (fora do git) e preencha.
# memoria = demonstração no navegador (PIN); supabase = banco real (login por usuário/e-mail e senha)
# Com banco, `?demo=1` na URL abre a demonstração nesta aba e `?demo=0` volta ao banco.
VITE_DADOS=memoria
# Projeto de teste: https://mogpmpypunsxxsbpeaef.supabase.co · oficial: https://pihmssohyyfcneeutbfq.supabase.co
VITE_SUPABASE_URL=
# Chave PÚBLICA (anon / publishable). Nunca a service_role/secret.
VITE_SUPABASE_ANON_KEY=
